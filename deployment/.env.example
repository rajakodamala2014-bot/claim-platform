# Copy to .env and fill in. Used by docker-compose.prod.yml. Never commit the real .env.
#
# Generate secrets with:   openssl rand -hex 32
# Generate the field key:  openssl rand -base64 32

# The URL users open in their browser (scheme + host, no trailing slash). Upload links are built from it.
PUBLIC_BASE_URL=https://claims.example.com

# Host port the gateway listens on (put a TLS-terminating load balancer or reverse proxy in front of it).
GATEWAY_PORT=8000

# PostgreSQL owner of the three databases (claims, insights, notification).
# Only applied when the postgres volume is first created.
DB_USER=claims
DB_PASSWORD=

# HS256 key that signs login tokens; shared by the gateway and the three services. At least 32 characters.
JWT_SECRET=

# HMAC key of pre-signed upload URLs (claims-service). At least 32 characters.
DOCUMENT_SIGNING_SECRET=

# HMAC key of the payments fallback webhook (claims-service). At least 32 characters.
PAYMENTS_WEBHOOK_SECRET=

# AES-256 key for bank account numbers at rest: base64 of exactly 32 random bytes.
# Keep it safe and unchanged: losing it makes stored account numbers unreadable.
FIELD_ENCRYPTION_KEY=

# HMAC key of e-mail / SMS / push delivery receipts (notification-service). At least 32 characters.
PROVIDER_CALLBACK_SECRET=

# Requests per minute per client at the gateway.
RATE_LIMIT_AUTHENTICATED=300
RATE_LIMIT_ANONYMOUS=60
