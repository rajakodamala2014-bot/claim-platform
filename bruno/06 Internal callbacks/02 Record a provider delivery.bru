meta {
  name: Record a provider delivery
  type: http
  seq: 2
}

post {
  url: {{notification}}/internal/v1/providers/fake-email/delivery-status
  body: json
  auth: none
}

script:pre-request {
  const crypto = require('crypto');
  const body = JSON.stringify({
    providerMessageId: bru.getEnvVar('providerMessageId') || 'fake-email-example',
    status: 'DELIVERED'
  });
  const sig = crypto.createHmac('sha256', bru.getEnvVar('providerCallbackSecret')).update(body).digest('hex');
  req.setHeader('Content-Type', 'application/json');
  req.setHeader('X-Signature', 'sha256=' + sig);
  req.setBody(body);
}

body:json {
  {}
}

docs {
  N7. Call notification-service directly on port 8082. status is DELIVERED or BOUNCED. providerMessageId is the id the provider returned when it accepted the message; the staff notification list shows it. An unknown id is 404.
}
