meta {
  name: Record a payment result
  type: http
  seq: 1
}

post {
  url: {{claims}}/internal/v1/payments/callback
  body: json
  auth: none
}

script:pre-request {
  const crypto = require('crypto');
  const body = JSON.stringify({
    instructionId: bru.getEnvVar('instructionId'),
    settlementId: bru.getEnvVar('settlementId'),
    claimId: bru.getEnvVar('claimId'),
    status: 'PAID',
    paymentRef: 'PAY-BRUNO',
    failureReason: null,
    amountMinor: 1200000,
    currency: 'SGD',
    processedAt: new Date().toISOString()
  });
  const sig = crypto.createHmac('sha256', bru.getEnvVar('paymentsWebhookSecret')).update(body).digest('hex');
  req.setHeader('Content-Type', 'application/json');
  req.setHeader('X-Signature', 'sha256=' + sig);
  req.setBody(body);
}

body:json {
  {}
}

docs {
  Fallback for Payments when it cannot use Kafka. Call claims-service directly on port 8080. The gateway answers 404 for /internal. The script signs the exact body. instructionId, settlementId and claimId come from Instruct payment. A result for an old instruction is ignored. status is PAID or FAILED.
}
