meta {
  name: Work queue, unassigned
  type: http
  seq: 1
}

get {
  url: {{gateway}}/staff/v1/work-queue
  body: none
  auth: bearer
}

auth:bearer {
  token: {{arunToken}}
}
params:query {
  view: unassigned
  market: SG
  sort: sla
  limit: 20
  ~lob: MOTOR
  ~cursor:
}

docs {
  I1. Oldest SLA deadline first. view is unassigned, mine or team. A handler only sees their markets.
}
