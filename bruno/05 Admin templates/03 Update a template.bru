meta {
  name: Update a template
  type: http
  seq: 3
}

put {
  url: {{gateway}}/admin/v1/templates/{{templateId}}
  body: none
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{leeToken}}
}

script:pre-request {

  const subject = bru.getVar("templateSubject");
  const body = bru.getVar("templateBody");
  req.setBody(JSON.stringify({ subject: subject, body: body }));

}


tests {
  test("wording is saved unchanged", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().id).to.equal(bru.getVar("templateId"));
    expect(res.getBody().subject).to.equal(bru.getVar("templateSubject"));
  });
}
