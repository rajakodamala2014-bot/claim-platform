meta {
  name: Update a template
  type: http
  seq: 2
}

put {
  url: {{gateway}}/admin/v1/templates/{{templateId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{leeToken}}
}
headers {
  Content-Type: application/json
}

body:json {
  {
    "subject": "We have received your claim \{{claimNumber}}",
    "body": "Thank you. We have received your claim \{{claimNumber}} and will keep you updated."
  }
}

docs {
  N6. Placeholders such as claimNumber stay in the text and must not be replaced by Bruno. The Local environment starts with templateId ClaimSubmitted.CUSTOMER.en. Listing templates overwrites that with the first row.
}
