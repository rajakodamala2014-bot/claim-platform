meta {
  name: List templates
  type: http
  seq: 1
}

get {
  url: {{gateway}}/admin/v1/templates
  body: none
  auth: bearer
}

auth:bearer {
  token: {{leeToken}}
}
script:post-response {
  const body = res.getBody();
  if (body && body.items && body.items.length) bru.setEnvVar('templateId', body.items[0].id);
}

docs {
  N6. Managers only. A handler or team lead is rejected by the gateway.
}
