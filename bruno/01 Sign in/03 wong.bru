meta {
  name: Sign in as wong
  type: http
  seq: 3
}

post {
  url: {{gateway}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "wong",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setEnvVar('wongToken', res.getBody().access_token);
  }
}

docs {
  Customer, Hong Kong. Subject cust-wong.
}
