meta {
  name: Sign in as kumar
  type: http
  seq: 6
}

post {
  url: {{gateway}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "kumar",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setEnvVar('kumarToken', res.getBody().access_token);
  }
}

docs {
  Handler, Singapore motor. Subject h-kumar.
}
