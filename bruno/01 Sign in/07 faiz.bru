meta {
  name: Sign in as faiz
  type: http
  seq: 7
}

post {
  url: {{gateway}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "faiz",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setEnvVar('faizToken', res.getBody().access_token);
  }
}

docs {
  Handler, Malaysia. Subject h-my-faiz.
}
