meta {
  name: faiz
  type: http
  seq: 7
}

post {
  url: {{gateway}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "faiz",
    "password": "{{password}}"
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.access_token) {
    bru.setVar("faizToken", body.access_token);
  }
}

tests {
  test("faiz can sign in", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.token_type).to.equal("Bearer");
    expect(body.sub).to.equal("h-my-faiz");
    expect(body.role).to.equal("CLAIMS_ADJUSTER");
  });
}
