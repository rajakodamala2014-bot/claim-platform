meta {
  name: Sign in as priya
  type: http
  seq: 1
}

post {
  url: {{gateway}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "priya",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setEnvVar('priyaToken', res.getBody().access_token);
  }
}

docs {
  Customer, Singapore. Subject cust-priya.
}
