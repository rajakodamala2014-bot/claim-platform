meta {
  name: ho
  type: http
  seq: 9
}

post {
  url: {{gateway}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "ho",
    "password": "{{password}}"
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.access_token) {
    bru.setVar("hoToken", body.access_token);
  }
}

tests {
  test("ho can sign in", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.token_type).to.equal("Bearer");
    expect(body.sub).to.equal("tl-hk-ho");
    expect(body.role).to.equal("TEAM_LEAD");
  });
}
