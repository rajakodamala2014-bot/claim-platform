meta {
  name: Sign in as ho
  type: http
  seq: 9
}

post {
  url: {{gateway}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "ho",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setEnvVar('hoToken', res.getBody().access_token);
  }
}

docs {
  Team lead, Hong Kong. Subject tl-hk-ho.
}
