meta {
  name: lee
  type: http
  seq: 10
}

post {
  url: {{gateway}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "lee",
    "password": "{{password}}"
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.access_token) {
    bru.setVar("leeToken", body.access_token);
  }
}

tests {
  test("lee can sign in", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.token_type).to.equal("Bearer");
    expect(body.sub).to.equal("m-lee");
    expect(body.role).to.equal("CLAIMS_ADJUSTER");
  });
}
