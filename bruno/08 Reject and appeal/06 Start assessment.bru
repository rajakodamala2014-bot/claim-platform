meta {
  name: Start assessment
  type: http
  seq: 6
}

post {
  url: {{gateway}}/staff/v1/claims/{{appealClaimId}}/start-assessment
  body: none
  auth: bearer
}

headers {
  If-Match: {{appealEtag}}
}

auth:bearer {
  token: {{arunToken}}
}


script:post-response {
  if (res.getHeader("etag")) bru.setVar("appealEtag", res.getHeader("etag"));
}

tests {
  test("assessment started", function () { expect(res.getStatus()).to.equal(200); });
}
