meta {
  name: Pick up
  type: http
  seq: 5
}

post {
  url: {{gateway}}/staff/v1/claims/{{appealClaimId}}/assignment
  body: none
  auth: bearer
}

headers {
  If-Match: {{appealEtag}}
}

auth:bearer {
  token: {{arunToken}}
}


script:post-response {
  if (res.getHeader("etag")) bru.setVar("appealEtag", res.getHeader("etag"));
}

tests {
  test("picked up", function () { expect(res.getStatus()).to.equal(200); });
}
