meta {
  name: Sign in as Priya
  type: http
  seq: 1
}

post {
  url: {{gateway}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "priya",
    "password": "{{password}}"
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.access_token) {
    bru.setVar("priyaToken", body.access_token);
  }
}

tests {
  test("priya can sign in", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.token_type).to.equal("Bearer");
    expect(body.sub).to.equal("cust-priya");
    expect(body.role).to.equal("CLAIMANT");
  });
}
