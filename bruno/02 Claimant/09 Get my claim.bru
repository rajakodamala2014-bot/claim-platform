meta {
  name: Get my claim
  type: http
  seq: 9
}

get {
  url: {{gateway}}/claimant/v1/claims/{{claimantClaimId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{priyaToken}}
}



tests {
  test("Priya can open her claim", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("TRIAGED");
  });
}
