meta {
  name: Withdraw my claim
  type: http
  seq: 12
}

post {
  url: {{gateway}}/claimant/v1/claims/{{claimId}}/withdraw
  body: json
  auth: bearer
}

auth:bearer {
  token: {{priyaToken}}
}
headers {
  Content-Type: application/json
}

body:json {
  {
    "reason": "Repaired privately, no longer claiming"
  }
}

docs {
  C9. Allowed only before a decision is pending. Do not run this on the claim the happy path is still settling.
}
