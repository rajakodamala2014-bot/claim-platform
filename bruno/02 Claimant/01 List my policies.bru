meta {
  name: List my policies
  type: http
  seq: 1
}

get {
  url: {{gateway}}/claimant/v1/policies
  body: none
  auth: bearer
}

auth:bearer {
  token: {{priyaToken}}
}
docs {
  C1. Policies of the signed-in customer, from the Policy system (cached 5 minutes). Priya has SG-MTR-POL-1001, SG-PRP-POL-2001 and the slow policy SG-MTR-POL-1500.
}
