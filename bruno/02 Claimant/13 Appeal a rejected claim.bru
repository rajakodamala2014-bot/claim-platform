meta {
  name: Appeal a rejected claim
  type: http
  seq: 13
}

post {
  url: {{gateway}}/claimant/v1/claims/{{claimId}}/appeal
  body: json
  auth: bearer
}

auth:bearer {
  token: {{priyaToken}}
}
headers {
  Content-Type: application/json
}

body:json {
  {
    "reason": "The workshop report shows the other driver was at fault"
  }
}

docs {
  C10. Only from REJECTED. Reopens the claim to UNDER_ASSESSMENT.
}
