meta {
  name: Answer an information request
  type: http
  seq: 11
}

post {
  url: {{gateway}}/claimant/v1/claims/{{claimId}}/info-requests/{{requestId}}/responses
  body: json
  auth: bearer
}

auth:bearer {
  token: {{priyaToken}}
}
headers {
  Content-Type: application/json
}

body:json {
  {
    "answer": "Police report PR-2026-1182 and the workshop quote are attached",
    "uploadIds": []
  }
}

docs {
  C8. Returns the claim to UNDER_ASSESSMENT. Refresh the staff ETag afterwards; the customer changed the version.
}
