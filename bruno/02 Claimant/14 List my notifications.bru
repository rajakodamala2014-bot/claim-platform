meta {
  name: List my notifications
  type: http
  seq: 14
}

get {
  url: {{gateway}}/claimant/v1/notifications
  body: none
  auth: bearer
}

auth:bearer {
  token: {{priyaToken}}
}
params:query {
  unreadOnly: false
}

script:post-response {
  const body = res.getBody();
  if (body && body.items && body.items.length) bru.setEnvVar('notificationId', body.items[0].id);
}

docs {
  N1. In-app inbox, newest first, at most 50. Stores the first id for mark-as-read.
}
