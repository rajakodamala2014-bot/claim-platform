meta {
  name: Save notification preferences
  type: http
  seq: 17
}

put {
  url: {{gateway}}/claimant/v1/notification-preferences
  body: json
  auth: bearer
}

auth:bearer {
  token: {{priyaToken}}
}
headers {
  Content-Type: application/json
}

body:json {
  {
    "language": "en",
    "email": { "enabled": true, "address": "priya@example.com" },
    "sms": { "enabled": true, "address": "+6591234567" },
    "push": { "enabled": false, "address": null }
  }
}

docs {
  N4. Replaces the stored preferences. Languages: en, zh, zh-Hant, ms, th, id.
}
