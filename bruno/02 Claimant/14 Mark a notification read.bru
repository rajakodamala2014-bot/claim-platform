meta {
  name: Mark a notification read
  type: http
  seq: 14
}

post {
  url: {{gateway}}/claimant/v1/notifications/{{notificationId}}/read
  body: none
  auth: bearer
}

auth:bearer {
  token: {{priyaToken}}
}



tests {
  test("the first message is marked read when one exists", function () {
    const id = bru.getVar("notificationId");
    if (!id) return;
    expect(res.getStatus()).to.equal(204);
  });
}
