meta {
  name: Retry a failed payment
  type: http
  seq: 15
}

post {
  url: {{gateway}}/staff/v1/claims/{{claimId}}/settlements/{{settlementId}}/retry
  body: json
  auth: bearer
}

auth:bearer {
  token: {{arunToken}}
}
headers {
  Content-Type: application/json
  If-Match: {{etag}}
}

body:json {
  {
    "payee": { "name": "Priya Nair", "bankCode": "DBSSSGSG", "accountNumber": "123456789" }
  }
}

script:post-response {
  const etag = res.getHeader('etag') || res.getHeader('ETag');
  if (etag) bru.setEnvVar('etag', etag);
}
docs {
  S12. Only when the payment failed. A new instruction id is used for every attempt. 409 SETTLEMENT_NOT_RETRYABLE if the payment did not fail.
}
