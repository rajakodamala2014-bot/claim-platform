meta {
  name: Approve within the handler limit
  type: http
  seq: 10
}

post {
  url: {{gateway}}/staff/v1/claims/{{staffClaimId}}/decisions
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  If-Match: {{staffEtag}}
}

auth:bearer {
  token: {{arunToken}}
}

body:json {
  {"outcome": "APPROVE", "amount": {"amount": "9000.00", "currency": "SGD"}}
}


script:post-response {
  if (res.getHeader("etag")) bru.setVar("staffEtag", res.getHeader("etag"));
}

tests {
  test("SGD 9000 is final for a handler", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("APPROVED");
    expect(res.getBody().result.approvalRequired).to.equal(false);
  });
}
