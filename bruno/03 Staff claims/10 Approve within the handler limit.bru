meta {
  name: Send the decision for approval
  type: http
  seq: 10
}

post {
  url: {{gateway}}/staff/v1/claims/{{staffClaimId}}/decisions
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  If-Match: {{staffEtag}}
}

auth:bearer {
  token: {{arunToken}}
}

body:json {
  {"outcome": "APPROVE", "coverage": "FULL", "amount": {"amount": "9000.00", "currency": "SGD"}}
}


script:post-response {
  bru.setVar("staffDecisionId", res.getBody().result.decisionId);
  if (res.getHeader("etag")) bru.setVar("staffEtag", res.getHeader("etag"));
}

tests {
  test("the decision waits for another claim manager", function () {
    expect(res.getStatus()).to.equal(202);
    expect(res.getBody().status).to.equal("DECISION_PENDING");
    expect(res.getBody().result.approvalRequired).to.equal(true);
  });
}
