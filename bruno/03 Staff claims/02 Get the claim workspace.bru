meta {
  name: Get the claim workspace
  type: http
  seq: 2
}

get {
  url: {{gateway}}/staff/v1/claims/{{claimId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{arunToken}}
}

script:post-response {
  const etag = res.getHeader('etag') || res.getHeader('ETag');
  if (etag) bru.setEnvVar('etag', etag);
}
docs {
  S2. Full handler view, including reserves. The ETag is the version for the next If-Match.
}
