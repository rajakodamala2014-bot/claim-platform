meta {
  name: Propose an approval above the handler limit
  type: http
  seq: 10
}

post {
  url: {{gateway}}/staff/v1/claims/{{claimId}}/decisions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{arunToken}}
}
headers {
  Content-Type: application/json
  If-Match: {{etag}}
}

body:json {
  {
    "outcome": "APPROVE",
    "amount": { "amount": "12000.00", "currency": "SGD" }
  }
}

script:post-response {
  const etag = res.getHeader('etag') || res.getHeader('ETag');
  if (etag) bru.setEnvVar('etag', etag);
  const body = res.getBody();
  if (body && body.result && body.result.decisionId) bru.setEnvVar('decisionId', body.result.decisionId);
}

docs {
  S9. SGD 12,000 is above Arun's SGD 10,000 handler limit, so this returns 202 and the claim stays DECISION_PENDING until a team lead approves. Within the limit the same call is final and returns 200.
}
