meta {
  name: Instruct payment
  type: http
  seq: 11
}

post {
  url: {{gateway}}/staff/v1/claims/{{staffClaimId}}/settlements
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  If-Match: {{staffEtag}}
}

auth:bearer {
  token: {{arunToken}}
}

body:json {
  {
    "payee": {"name": "Priya Nair", "bankCode": "DBSSSGSG", "accountNumber": "123456789"},
    "amount": {"amount": "9000.00", "currency": "SGD"}
  }
}


script:post-response {

  bru.setVar("staffSettlementId", res.getBody().result.settlementId);
  if (res.getHeader("etag")) bru.setVar("staffEtag", res.getHeader("etag"));

}

tests {
  test("payment is instructed", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
