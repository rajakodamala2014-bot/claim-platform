meta {
  name: Instruct payment
  type: http
  seq: 14
}

post {
  url: {{gateway}}/staff/v1/claims/{{claimId}}/settlements
  body: json
  auth: bearer
}

auth:bearer {
  token: {{arunToken}}
}
headers {
  Content-Type: application/json
  If-Match: {{etag}}
}

body:json {
  {
    "payee": { "name": "Priya Nair", "bankCode": "DBSSSGSG", "accountNumber": "123456789" },
    "amount": { "amount": "12000.00", "currency": "SGD" }
  }
}

script:post-response {
  const etag = res.getHeader('etag') || res.getHeader('ETag');
  if (etag) bru.setEnvVar('etag', etag);
  const body = res.getBody();
  if (body && body.result) {
    bru.setEnvVar('settlementId', body.result.settlementId);
    bru.setEnvVar('instructionId', body.result.instructionId);
  }
}

docs {
  S11. Claim becomes SETTLEMENT_IN_PROGRESS. The payments simulator pays this account. An account ending in 0000 is failed by the simulator. The claim becomes SETTLED when the payment result arrives, a few seconds later.
}
