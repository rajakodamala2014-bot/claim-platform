meta {
  name: Another claim manager approves
  type: http
  seq: 11
}

post {
  url: {{gateway}}/staff/v1/claims/{{staffClaimId}}/decisions/{{staffDecisionId}}/approval
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  If-Match: {{staffEtag}}
}

auth:bearer {
  token: {{meeraToken}}
}

body:json {
  {"action": "APPROVE"}
}

script:post-response {
  if (res.getHeader("etag")) bru.setVar("staffEtag", res.getHeader("etag"));
}

tests {
  test("the claim is approved by another claim manager", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("APPROVED");
  });
}
