meta {
  name: Sign in as Meera
  type: http
  seq: 3
}

post {
  url: {{gateway}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "meera",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setEnvVar('meeraToken', res.getBody().access_token);
  }
}

docs {
  Team lead who can approve Arun when the amount is over his limit.
}
