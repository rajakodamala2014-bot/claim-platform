meta {
  name: Request an upload
  type: http
  seq: 6
}

post {
  url: {{gateway}}/claimant/v1/uploads
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{priyaToken}}
}

body:json {
  {
    "fileName": "dashcam.jpg",
    "contentType": "image/jpeg",
    "sizeBytes": 11
  }
}


script:post-response {

  const body = res.getBody();
  bru.setVar("uploadId", body.uploadId);
  bru.setVar("uploadUrl", body.uploadUrl);

}

tests {
  test("an upload link is issued", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().uploadId).to.be.a("string");
    expect(res.getBody().uploadUrl).to.be.a("string");
  });
}
