meta {
  name: Sign in as Lee
  type: http
  seq: 4
}

post {
  url: {{gateway}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "lee",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setEnvVar('leeToken', res.getBody().access_token);
  }
}

docs {
  Manager. Used for the exposure dashboard at the end.
}
