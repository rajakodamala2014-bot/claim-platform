meta {
  name: Approve the decision
  type: http
  seq: 23
}

post {
  url: {{gateway}}/staff/v1/claims/{{claimId}}/decisions/{{decisionId}}/approval
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  If-Match: {{etag}}
}

auth:bearer {
  token: {{meeraToken}}
}

body:json {
  {"action": "APPROVE"}
}


script:post-response {

  const etag = res.getHeader("etag");
  if (etag) bru.setVar("etag", etag);

}

tests {
  test("the claim is approved", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("APPROVED");
  });
}
