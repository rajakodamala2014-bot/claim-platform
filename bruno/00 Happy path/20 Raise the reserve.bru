meta {
  name: Raise the reserve
  type: http
  seq: 20
}

post {
  url: {{gateway}}/staff/v1/claims/{{claimId}}/reserves
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  If-Match: {{etag}}
}

auth:bearer {
  token: {{arunToken}}
}

body:json {
  {"amount": {"amount": "12000.00", "currency": "SGD"}, "reason": "Repair quote received"}
}


script:post-response {

  const etag = res.getHeader("etag");
  if (etag) bru.setVar("etag", etag);

}

tests {
  test("reserve follows the quote", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().result.amount).to.equal("12000.00");
  });
}
