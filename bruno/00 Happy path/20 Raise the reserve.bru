meta {
  name: Raise the reserve
  type: http
  seq: 20
}

post {
  url: {{gateway}}/staff/v1/claims/{{claimId}}/reserves
  body: json
  auth: bearer
}

auth:bearer {
  token: {{arunToken}}
}
headers {
  Content-Type: application/json
  If-Match: {{etag}}
}
body:json {
  {
    "amount": { "amount": "12000.00", "currency": "SGD" },
    "reason": "Repair quote received"
  }
}

script:post-response {
  const etag = res.getHeader('etag') || res.getHeader('ETag');
  if (etag) bru.setEnvVar('etag', etag);
}
docs {
  S6. Reserve follows the quote.
}
