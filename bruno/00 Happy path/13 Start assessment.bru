meta {
  name: Start assessment
  type: http
  seq: 13
}

post {
  url: {{gateway}}/staff/v1/claims/{{claimId}}/start-assessment
  body: none
  auth: bearer
}

headers {
  If-Match: {{etag}}
}

auth:bearer {
  token: {{arunToken}}
}


script:post-response {

  const etag = res.getHeader("etag");
  if (etag) bru.setVar("etag", etag);

}

tests {
  test("assessment starts", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("UNDER_ASSESSMENT");
  });
}
