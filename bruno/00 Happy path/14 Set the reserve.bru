meta {
  name: Set the reserve
  type: http
  seq: 14
}

post {
  url: {{gateway}}/staff/v1/claims/{{claimId}}/reserves
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  If-Match: {{etag}}
}

auth:bearer {
  token: {{arunToken}}
}

body:json {
  {"amount": {"amount": "5000.00", "currency": "SGD"}, "reason": "Initial estimate"}
}


script:post-response {

  const etag = res.getHeader("etag");
  if (etag) bru.setVar("etag", etag);

}

tests {
  test("reserve is SGD 5000", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().result.amount).to.equal("5000.00");
    expect(res.getBody().result.currency).to.equal("SGD");
  });
}
