meta {
  name: Record the assessment
  type: http
  seq: 19
}

post {
  url: {{gateway}}/staff/v1/claims/{{claimId}}/assessments
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  If-Match: {{etag}}
}

auth:bearer {
  token: {{arunToken}}
}

body:json {
  {"liability": "FULL", "assessedAmount": {"amount": "12000.00", "currency": "SGD"}, "notes": "Third party at fault, CCTV confirms"}
}


script:post-response {

  const etag = res.getHeader("etag");
  if (etag) bru.setVar("etag", etag);

}

tests {
  test("assessment is recorded", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().result).to.be.a("string");
  });
}
