meta {
  name: Customer sees the request
  type: http
  seq: 16
}

get {
  url: {{gateway}}/claimant/v1/claims/{{claimId}}/info-requests
  body: none
  auth: bearer
}

auth:bearer {
  token: {{priyaToken}}
}



tests {
  test("Priya sees what was asked", function () {
    expect(res.getStatus()).to.equal(200);
    expect(JSON.stringify(res.getBody().items)).to.include("Police report");
  });
}
