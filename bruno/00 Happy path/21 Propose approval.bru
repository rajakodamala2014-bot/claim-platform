meta {
  name: Propose approval
  type: http
  seq: 21
}

post {
  url: {{gateway}}/staff/v1/claims/{{claimId}}/decisions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{arunToken}}
}
headers {
  Content-Type: application/json
  If-Match: {{etag}}
}
body:json {
  {
    "outcome": "APPROVE",
    "amount": { "amount": "12000.00", "currency": "SGD" }
  }
}

script:post-response {
  const etag = res.getHeader('etag') || res.getHeader('ETag');
  if (etag) bru.setEnvVar('etag', etag);
  const body = res.getBody();
  if (body && body.result && body.result.decisionId) bru.setEnvVar('decisionId', body.result.decisionId);
}
docs {
  S9. Expect 202. SGD 12,000 is above the handler limit, so Meera must approve.
}
