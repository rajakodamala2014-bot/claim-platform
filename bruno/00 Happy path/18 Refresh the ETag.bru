meta {
  name: Refresh the ETag
  type: http
  seq: 18
}

get {
  url: {{gateway}}/staff/v1/claims/{{claimId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{arunToken}}
}


script:post-response {

  const etag = res.getHeader("etag");
  if (etag) bru.setVar("etag", etag);

}

tests {
  test("workspace still opens", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("etag")).to.be.a("string");
  });
}
